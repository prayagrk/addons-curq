<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position='after'>
                <block
                    title="Default Company Watermark Configuration"
                    name="outgoing_report_for_default_company_watermark"
                >
                    <setting>
                        <field
                            name="outgoing_report_config_ids"
                            widget="many2many_tags"
                            help="Configure the reports that should use the default
                               company logo when a report-specific logo is not configured."
                            nolabel="1"
                            options="{'no_create':True}"
                        />
                        <div
                            class="text-muted"
                            id="mail_tracking_email_max_age_days"
                        >Configure the reports that should use the default
                               company logo when a report-specific logo is not configured.</div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</data>
